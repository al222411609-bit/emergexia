# ── MongoDB (base de datos principal) ───────────────────
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net
# Con usuario local: mongodb://USUARIO:CONTRASEÑA@localhost:27017/?authSource=admin
# Tip: en MongoDB Compass, clic derecho sobre tu conexión → "Copy connection string"
MONGO_URI=mongodb://localhost:27017
MONGO_DB=emergexia
# true = rellena las colecciones vacías con datos de ejemplo
SEED_DEMO_DATA=false

# ── Spark (análisis; se inicia solo cuando se necesita) ─────────────────────────────────────────────
# local[*]                → Spark embebido en el proceso (no requiere clúster)
# spark://HOST:7077       → Clúster Spark standalone
# yarn / k8s://...        → Otros gestores de clúster
SPARK_MASTER=local[*]
SPARK_APP_NAME=Emergexia
SPARK_UI_ENABLED=false
SPARK_SHUFFLE_PARTITIONS=4
SPARK_DRIVER_MEMORY=1g
# Solo si usas un clúster remoto y los workers no alcanzan al driver:
# SPARK_DRIVER_HOST=192.168.1.10


# ── Seguridad ───────────────────────────────────────────
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_EXPIRE_MINUTES=480

# Administrador inicial: se crea en MongoDB solo la primera vez (si no hay usuarios).
# Para cambiar la contraseña después:  python crear_usuario.py admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Yessica López

# Orígenes permitidos (frontend)
CORS_ORIGINS=http://localhost:5173
